ame: Build Origin

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install PlatformIO
        run: pip install platformio

      - name: Install ESP32-S3 toolchain
        run: |
          pio pkg install --global --platform "espressif32@6.5.0"
          pio pkg install --global --tool "toolchain-xtensa-esp32s3"

      - name: Patch libnet80211
        run: |
          echo "=== Searching for libnet80211.a ==="
          find ~/.platformio -name "libnet80211.a" || echo "NOT FOUND"
          LIB_PATH=$(find ~/.platformio -name "libnet80211.a" -path "*esp32s3*" | head -1)
          echo "=== Found: $LIB_PATH ==="
          if [ -z "$LIB_PATH" ]; then
            echo "ERROR: not found"
            exit 1
          fi
          OBJCOPY=$(find ~/.platformio -name "xtensa-esp32s3-elf-objcopy" | head -1)
          echo "=== objcopy: $OBJCOPY ==="
          if [ -z "$OBJCOPY" ]; then
            echo "ERROR: objcopy not found"
            exit 1
          fi
          "$OBJCOPY" --weaken-symbol=ieee80211_raw_frame_sanity_check "$LIB_PATH"
          echo "=== PATCHED ==="

      - name: Build StickS3
        run: pio run -e sticks3

      - name: Upload firmware
        uses: actions/upload-artifact@v4
        with:
          name: origin-fw-sticks3
          path: .pio/build/sticks3/firmware.bin

